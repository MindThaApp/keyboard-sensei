{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    // Without this, TS auto-includes every @types/* package found anywhere
    // in the pnpm store as global ambient types -- opensheetmusicdisplay's
    // transitive @types/vexflow (an old 1.x-era ambient `declare module
    // "vexflow"`) was shadowing this app's own real vexflow 4.x module
    // resolution project-wide, breaking NotationRenderer.tsx's unrelated
    // imports. Whitelisting only what this app actually needs avoids that
    // class of transitive-dependency type pollution going forward.
    "types": ["node", "react", "react-dom"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@keyboard-sensei/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@keyboard-sensei/lesson-engine": ["../../packages/lesson-engine/src/index.ts"],
      "@keyboard-sensei/midi-engine": ["../../packages/midi-engine/src/index.ts"],
      "@keyboard-sensei/midi-engine/web": ["../../packages/midi-engine/src/web.ts"],
      "@keyboard-sensei/playalong-core": ["../../packages/playalong-core/src/index.ts"],
      "@keyboard-sensei/music-theory": ["../../packages/music-theory/src/index.ts"]
    }
  },
  "include": ["src", "scripts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

