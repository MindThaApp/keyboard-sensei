generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgressStatus {
  locked
  unlocked
  completed
}

enum Role {
  user
  admin
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  display_name       String
  narration_voice_id String?
  password_hash      String
  // NULL until the address is proven (verification link, password reset or Google).
  // Enforced at login only when REQUIRE_EMAIL_VERIFICATION is on.
  email_verified_at  DateTime?
  // Google account subject id ("sub" claim), set when the user signs in with Google.
  google_sub         String?            @unique
  role               Role               @default(user)
  // Bumped to void every access token issued before it (password change/reset, sign out everywhere).
  token_version      Int                @default(0)
  // Minutes of practice a day the learner aims for (5 / 10 / 15 / 20).
  daily_goal_minutes Int                @default(10)
  // IANA zone the browser reported, so "today" and streak days follow the
  // learner's own midnight. NULL until the web app first reports it (UTC).
  timezone           String?
  // "simple" | "advanced": the interface mode, synced so a new device picks it up.
  // NULL until the user has chosen one.
  experience_mode    String?
  created_at         DateTime           @default(now())
  attempts           ExerciseAttempt[]
  quiz_attempts      QuizAttempt[]
  progress           UserProgress[]
  feedback           Feedback[]
  songs              Song[]
  instruments        Instrument[]
  playalong_attempts PlayAlongAttempt[]
  achievements       UserAchievement[]
  tts_usage          TtsUserUsage[]
  xp_events          XpEvent[]
  practice_days      PracticeDay[]
  auth_tokens        AuthToken[]
  game_rounds        GameRound[]
}

/// Single-use emailed tokens (password reset, email verification). Only the SHA-256
/// of the token is stored, so a database leak cannot be replayed into a reset.
model AuthToken {
  id         String    @id @default(cuid())
  user_id    String
  // "password_reset" | "email_verification"
  purpose    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
}

/// One XP award. The ledger is the source of truth for a learner's XP: the total is
/// the sum of `amount`. Every award carries a `dedupe_key` naming what earned it
/// ("exercise-attempt:<id>", "first-pass:<exerciseId>", "daily-goal:<day>", ...), so
/// the same thing can never pay twice and the history backfill is safe to re-run.
model XpEvent {
  id         String   @id @default(cuid())
  user_id    String
  // exercise | lesson | quiz | playalong | star | daily_goal | streak
  source     String
  amount     Int
  reason     String
  dedupe_key String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, dedupe_key])
  @@index([user_id, created_at])
}

/// Practice time per learner per calendar day (in their timezone), and whether that
/// day's goal was met. `goal_minutes` is the goal in force that day, so raising the
/// goal later never un-meets a past day and breaks a streak retroactively.
model PracticeDay {
  id           String    @id @default(cuid())
  user_id      String
  // YYYY-MM-DD in the learner's timezone.
  day          String
  seconds      Int       @default(0)
  goal_minutes Int
  goal_met_at  DateTime?
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, day])
}

model UserAchievement {
  id              String   @id @default(cuid())
  user_id         String
  achievement_key String
  unlocked_at     DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, achievement_key])
}

model Feedback {
  id         String   @id @default(cuid())
  user_id    String?
  type       String
  message    String
  page_path  String
  user_agent String
  status     String   @default("open")
  // Filename within FEEDBACK_SCREENSHOT_DIR, not a path -- served via
  // GET /admin/feedback/:id/screenshot behind requireAdmin, never returned
  // to clients directly (see the notation_path lesson in songs.ts).
  screenshot String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model Song {
  id                   String             @id @default(cuid())
  title                String
  artist               String
  genre                String
  difficulty           Int
  duration_sec         Float
  note_count           Int
  content_rights       String
  source_url           String?
  notation_path        String?
  file_path            String
  uploader_id          String?
  created_at           DateTime           @default(now())
  // One piece offered at several difficulty levels (the Essentials pack):
  // every version of a piece shares `arrangement_group`; `arrangement_level`
  // is "beginner" | "intermediate" | "full". NULL for ordinary songs.
  arrangement_group    String?
  arrangement_level    String?
  // Credit line required by the source's licence (e.g. CC BY typesetting).
  attribution          String?
  // A library song superseded by a better version of the same piece. Hidden
  // from the song list but kept, because users' play-along history points at it.
  retired_at           DateTime?
  // Catalogue (library redesign). All nullable or defaulted, filled by
  // src/catalogue/backfill.ts; nothing above is derived from them yet.
  // The piece this song is a version of. NULL for uploads and unmapped library songs.
  work_id              String?
  // essentials | beginner | piano-midi-de | mutopia | authored | adl | upload | recording | archive
  source_kind          String?
  // Mutopia id, piano-midi.de filename, ADL manifest id, or sha256.
  source_ref           String?
  // Licence of the FILE (not the composition): public-domain | cc-by-* | cc-by-sa-* | cc-by-nc-* | unknown
  file_licence         String?
  public_eligible      Boolean            @default(false)
  // verified | good | unrated | low
  quality_tier         String             @default("unrated")
  quality_score        Float?
  quality_signals      Json?
  quality_checked_at   DateTime?
  tier_override        String?
  tier_override_reason String?
  grade_band           String?
  // both | right-hand-melody | single-line
  hands                String?
  uploader             User?              @relation(fields: [uploader_id], references: [id], onDelete: Cascade)
  work                 Work?              @relation(fields: [work_id], references: [id], onDelete: SetNull)
  attempts             PlayAlongAttempt[]

  @@index([uploader_id])
  @@index([arrangement_group])
  @@index([work_id])
  @@index([quality_tier])
  @@index([public_eligible])
}

model Composer {
  // Slug, e.g. "frederic-chopin".
  id        String   @id
  name      String
  // "Chopin, Frédéric"
  sort_name String
  born      Int?
  died      Int?
  aliases   String[]
  works     Work[]
}

/// One piece of music. Its versions (Essentials levels, the beginner-pack
/// arrangement, library copies) are the Songs that point at it.
model Work {
  // Slug, e.g. "fur-elise" (Essentials works use their arrangement_group).
  id              String      @id
  // Display title; may already include the catalogue number or movement.
  title           String
  composer_id     String?
  // "Op. 28 No. 4"
  catalogue       String?
  movement        String?
  // baroque | classical-era | romantic | impressionist | early-20th-c | ragtime | traditional | modern
  era             String?
  // classical | folk | hymn-carol | ragtime | childrens | teaching | march | other
  genre           String
  published_year  Int?
  // pd-worldwide | pd-us-eu | copyrighted | unknown
  pd_status       String
  // Curated rank, lower = more recognisable.
  recognisability Int?
  featured_rank   Int?
  // draft | in_review | published | hidden | retired
  curation_status String      @default("draft")
  // Title, aliases, catalogue tokens, composer and tags, maintained by the
  // application; the search indexes (raw SQL in the migration) are built on it.
  search_text     String      @default("")
  notes           String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  composer        Composer?   @relation(fields: [composer_id], references: [id])
  aliases         WorkAlias[]
  tags            WorkTag[]
  songs           Song[]

  @@index([genre])
  @@index([curation_status])
}

model WorkAlias {
  id      String @id @default(cuid())
  work_id String
  alias   String
  // title | nickname | catalogue | translation
  kind    String
  work    Work   @relation(fields: [work_id], references: [id], onDelete: Cascade)

  @@unique([work_id, alias])
}

model Tag {
  id    String    @id
  label String
  // collection | mood
  kind  String
  works WorkTag[]
}

model WorkTag {
  work_id String
  tag_id  String
  work    Work   @relation(fields: [work_id], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([work_id, tag_id])
}

/// Audit log of catalogue changes.
model CatalogueEvent {
  id       String   @id @default(cuid())
  actor_id String?
  work_id  String?
  song_id  String?
  // import | classify | publish | retire | unretire | merge | override_tier | edit
  action   String
  before   Json?
  after    Json?
  reason   String?
  at       DateTime @default(now())

  @@index([song_id])
  @@index([work_id])
}

model Instrument {
  id             String   @id @default(cuid())
  name           String
  description    String
  category       String
  pack_path      String
  source_url     String?
  uploader_id    String?
  content_rights String
  created_at     DateTime @default(now())
  uploader       User?    @relation(fields: [uploader_id], references: [id], onDelete: Cascade)
}

model ArchiveEntry {
  id           String @id @default(cuid())
  title        String
  composer     String
  duration_sec Float
  note_count   Int
  difficulty   Int
  source_ref   String
}

model PlayAlongAttempt {
  id                String   @id @default(cuid())
  user_id           String
  song_id           String
  score             Float
  accuracy          Float
  // Playback rate as a percentage of the song's own tempo. Continuous since
  // 2026-07-12 (was Int 25/50/75/100). This is the authoritative field: it is
  // meaningful for every song, including the rubato/tempo-curve performance
  // MIDIs the library is built from.
  tempo_pct         Float
  // Absolute BPM the user chose, recorded only when the song had a single
  // stable tempo to derive it from. NULL for every pre-2026-07-12 row and for
  // any song whose MIDI has a tempo curve — Song has no bpm column and
  // tempos[0] is a fiction for those, so this is display-only, never scored.
  tempo_bpm         Float?
  lookahead_s       Float
  wait_mode         Boolean
  // Song practice (all NULL on rows from before it existed, read as a full,
  // two-handed, whole-song run):
  // "full" | "simplified" | "easy" | "melody" — the "Make it easier" step.
  arrangement_level String?
  // "both" | "right" | "left" — the hand(s) the player was judged on.
  hands             String?
  // 1-based, inclusive bar numbers of a looped section.
  loop_start_bar    Int?
  loop_end_bar      Int?
  // The score multiplier the run earned (speed × look-ahead × level × hands, capped at 1.5).
  multiplier        Float?
  // A run of a looped section: practice, never a full-song best.
  is_loop           Boolean  @default(false)
  created_at        DateTime @default(now())
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  song              Song     @relation(fields: [song_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model TtsUsage {
  id             String   @id @default(cuid())
  period         String   @unique
  charactersUsed Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model TtsNarration {
  id             String   @id @default(cuid())
  lessonId       String
  sectionIndex   Int
  voiceId        String
  filePath       String
  characterCount Int
  createdAt      DateTime @default(now())

  @@unique([lessonId, sectionIndex, voiceId])
}

/// Characters of NEW narration (cache misses only) each user triggered per UTC day.
/// Enforces a per-user daily cap so one account cannot drain the shared monthly pool.
model TtsUserUsage {
  id             String   @id @default(cuid())
  user_id        String
  day            String
  charactersUsed Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, day])
}

model Lesson {
  id            String         @id
  lesson_json   Json
  path          String
  level         String
  branch        String
  /// Tiered level on Learn, 0 (first steps) to 7 (advanced). Set by the seed from content/tiers.ts.
  tier          Int            @default(0)
  /// Skill chips shown on the lesson row (see SKILL_CHIPS in shared-types).
  skills        String[]       @default([])
  order         Int            @unique
  /// Set by the seed when a lesson leaves the content but user data still references
  /// it: the row is kept (history survives), hidden from the course, and given a
  /// negative order so it sits outside the 1..N unlock chain. NULL = live lesson.
  retired_at    DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  exercises     Exercise[]
  quiz_attempts QuizAttempt[]
  progress      UserProgress[]
}

model Exercise {
  id            String            @id
  exercise_json Json
  lesson_id     String
  /// Same policy as Lesson.retired_at: removed from content but has attempts.
  retired_at    DateTime?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  lesson        Lesson            @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  attempts      ExerciseAttempt[]
}

model ExerciseAttempt {
  id               String   @id @default(cuid())
  user_id          String
  exercise_id      String
  submitted_events Json
  performed_notes  Json
  result           Json
  created_at       DateTime @default(now())
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise         Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model QuizAttempt {
  id              String   @id @default(cuid())
  user_id         String
  lesson_id       String
  question_id     String
  selected_answer Int
  correct         Boolean
  created_at      DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([user_id, lesson_id])
}

model UserProgress {
  id           String         @id @default(cuid())
  user_id      String
  lesson_id    String
  status       ProgressStatus @default(locked)
  best_score   Float          @default(0)
  completed_at DateTime?
  updated_at   DateTime       @updatedAt
  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
}

/// One finished round of a practice game (note reading today). `slowest` is the learner's
/// slowest notes that round, [{ note, medianMs }], which feeds "Practise these".
model GameRound {
  id         String   @id @default(cuid())
  user_id    String
  game       String
  correct    Int
  total      Int
  median_ms  Int
  seconds    Int
  config     Json
  slowest    Json
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, game, created_at])
}
