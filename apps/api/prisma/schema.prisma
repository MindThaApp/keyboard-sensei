generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgressStatus {
  locked
  unlocked
  completed
}

enum Role {
  user
  admin
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  display_name       String
  narration_voice_id String?
  password_hash      String
  role               Role               @default(user)
  created_at         DateTime           @default(now())
  attempts           ExerciseAttempt[]
  quiz_attempts      QuizAttempt[]
  progress           UserProgress[]
  feedback           Feedback[]
  songs              Song[]
  instruments        Instrument[]
  playalong_attempts PlayAlongAttempt[]
  achievements       UserAchievement[]
  tts_usage          TtsUserUsage[]
}

model UserAchievement {
  id              String   @id @default(cuid())
  user_id         String
  achievement_key String
  unlocked_at     DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, achievement_key])
}

model Feedback {
  id         String   @id @default(cuid())
  user_id    String?
  type       String
  message    String
  page_path  String
  user_agent String
  status     String   @default("open")
  // Filename within FEEDBACK_SCREENSHOT_DIR, not a path -- served via
  // GET /admin/feedback/:id/screenshot behind requireAdmin, never returned
  // to clients directly (see the notation_path lesson in songs.ts).
  screenshot String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model Song {
  id             String             @id @default(cuid())
  title          String
  artist         String
  genre          String
  difficulty     Int
  duration_sec   Float
  note_count     Int
  content_rights String
  source_url     String?
  notation_path  String?
  file_path      String
  uploader_id    String?
  created_at     DateTime           @default(now())
  uploader       User?              @relation(fields: [uploader_id], references: [id], onDelete: Cascade)
  attempts       PlayAlongAttempt[]

  @@index([uploader_id])
}

model Instrument {
  id             String   @id @default(cuid())
  name           String
  description    String
  category       String
  pack_path      String
  source_url     String?
  uploader_id    String?
  content_rights String
  created_at     DateTime @default(now())
  uploader       User?    @relation(fields: [uploader_id], references: [id], onDelete: Cascade)
}

model ArchiveEntry {
  id           String @id @default(cuid())
  title        String
  composer     String
  duration_sec Float
  note_count   Int
  difficulty   Int
  source_ref   String
}

model PlayAlongAttempt {
  id          String   @id @default(cuid())
  user_id     String
  song_id     String
  score       Float
  accuracy    Float
  // Playback rate as a percentage of the song's own tempo. Continuous since
  // 2026-07-12 (was Int 25/50/75/100). This is the authoritative field: it is
  // meaningful for every song, including the rubato/tempo-curve performance
  // MIDIs the library is built from.
  tempo_pct   Float
  // Absolute BPM the user chose, recorded only when the song had a single
  // stable tempo to derive it from. NULL for every pre-2026-07-12 row and for
  // any song whose MIDI has a tempo curve — Song has no bpm column and
  // tempos[0] is a fiction for those, so this is display-only, never scored.
  tempo_bpm   Float?
  lookahead_s Float
  wait_mode   Boolean
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  song        Song     @relation(fields: [song_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model TtsUsage {
  id             String   @id @default(cuid())
  period         String   @unique
  charactersUsed Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model TtsNarration {
  id             String   @id @default(cuid())
  lessonId       String
  sectionIndex   Int
  voiceId        String
  filePath       String
  characterCount Int
  createdAt      DateTime @default(now())

  @@unique([lessonId, sectionIndex, voiceId])
}

/// Characters of NEW narration (cache misses only) each user triggered per UTC day.
/// Enforces a per-user daily cap so one account cannot drain the shared monthly pool.
model TtsUserUsage {
  id             String   @id @default(cuid())
  user_id        String
  day            String
  charactersUsed Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, day])
}

model Lesson {
  id            String         @id
  lesson_json   Json
  path          String
  level         String
  branch        String
  order         Int            @unique
  /// Set by the seed when a lesson leaves the content but user data still references
  /// it: the row is kept (history survives), hidden from the course, and given a
  /// negative order so it sits outside the 1..N unlock chain. NULL = live lesson.
  retired_at    DateTime?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  exercises     Exercise[]
  quiz_attempts QuizAttempt[]
  progress      UserProgress[]
}

model Exercise {
  id            String            @id
  exercise_json Json
  lesson_id     String
  /// Same policy as Lesson.retired_at: removed from content but has attempts.
  retired_at    DateTime?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  lesson        Lesson            @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  attempts      ExerciseAttempt[]
}

model ExerciseAttempt {
  id               String   @id @default(cuid())
  user_id          String
  exercise_id      String
  submitted_events Json
  performed_notes  Json
  result           Json
  created_at       DateTime @default(now())
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise         Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model QuizAttempt {
  id              String   @id @default(cuid())
  user_id         String
  lesson_id       String
  question_id     String
  selected_answer Int
  correct         Boolean
  created_at      DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([user_id, lesson_id])
}

model UserProgress {
  id           String         @id @default(cuid())
  user_id      String
  lesson_id    String
  status       ProgressStatus @default(locked)
  best_score   Float          @default(0)
  completed_at DateTime?
  updated_at   DateTime       @updatedAt
  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
}
