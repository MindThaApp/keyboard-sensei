generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgressStatus {
  locked
  unlocked
  completed
}

enum Role {
  user
  admin
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  display_name       String
  narration_voice_id String?
  password_hash      String
  role               Role               @default(user)
  created_at         DateTime           @default(now())
  attempts           ExerciseAttempt[]
  quiz_attempts      QuizAttempt[]
  progress           UserProgress[]
  feedback           Feedback[]
  songs              Song[]
  playalong_attempts PlayAlongAttempt[]
}

model Feedback {
  id         String   @id @default(cuid())
  user_id    String?
  type       String
  message    String
  page_path  String
  user_agent String
  status     String   @default("open")
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model Song {
  id             String             @id @default(cuid())
  title          String
  artist         String
  genre          String
  difficulty     Int
  duration_sec   Float
  note_count     Int
  content_rights String
  source_url     String?
  notation_path  String?
  file_path      String
  uploader_id    String?
  created_at     DateTime           @default(now())
  uploader       User?              @relation(fields: [uploader_id], references: [id], onDelete: Cascade)
  attempts       PlayAlongAttempt[]
}

model ArchiveEntry {
  id           String @id @default(cuid())
  title        String
  composer     String
  duration_sec Float
  note_count   Int
  difficulty   Int
  source_ref   String
}

model PlayAlongAttempt {
  id          String   @id @default(cuid())
  user_id     String
  song_id     String
  score       Float
  accuracy    Float
  tempo_pct   Int
  lookahead_s Float
  wait_mode   Boolean
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  song        Song     @relation(fields: [song_id], references: [id], onDelete: Cascade)
}

model TtsUsage {
  id             String   @id @default(cuid())
  period         String   @unique
  charactersUsed Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model TtsNarration {
  id             String   @id @default(cuid())
  lessonId       String
  sectionIndex   Int
  voiceId        String
  filePath       String
  characterCount Int
  createdAt      DateTime @default(now())

  @@unique([lessonId, sectionIndex, voiceId])
}

model Lesson {
  id            String         @id
  lesson_json   Json
  path          String
  level         String
  branch        String
  order         Int            @unique
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  exercises     Exercise[]
  quiz_attempts QuizAttempt[]
  progress      UserProgress[]
}

model Exercise {
  id            String            @id
  exercise_json Json
  lesson_id     String
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt
  lesson        Lesson            @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  attempts      ExerciseAttempt[]
}

model ExerciseAttempt {
  id               String   @id @default(cuid())
  user_id          String
  exercise_id      String
  submitted_events Json
  performed_notes  Json
  result           Json
  created_at       DateTime @default(now())
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise         Exercise @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id              String   @id @default(cuid())
  user_id         String
  lesson_id       String
  question_id     String
  selected_answer Int
  correct         Boolean
  created_at      DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
}

model UserProgress {
  id           String         @id @default(cuid())
  user_id      String
  lesson_id    String
  status       ProgressStatus @default(locked)
  best_score   Float          @default(0)
  completed_at DateTime?
  updated_at   DateTime       @updatedAt
  user         User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
}
