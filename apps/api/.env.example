DATABASE_URL=postgresql://keyboard_sensei:keyboard_sensei@localhost:5432/keyboard_sensei
JWT_SECRET=replace-with-a-local-secret-at-least-16-characters
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Optional. "false" closes self-service sign-up (POST /auth/register -> 403); admins can
# still create accounts from the admin area. Default: true.
REGISTRATION_OPEN=true
# Optional. Reverse-proxy hops in front of the API, for client-IP rate limiting.
# 0 for local dev; the LAN deploy (Caddy -> nginx -> api) sets 2. Default: 0.
TRUST_PROXY=0
# Optional. Max NEW narration characters one user may trigger per UTC day. Default: 2500.
TTS_USER_DAILY_LIMIT=2500
# Optional. Seeded admin password; required when NODE_ENV=production.
# ADMIN_PASSWORD=
# Optional. "true" serves only the Essentials and beginner packs (plus each user's own
# uploads); the ADL library is admin-only and the piano archive is switched off. Default: false.
# PUBLIC_CATALOGUE=false
# Optional. "true" makes new accounts confirm their email before signing in. Default: false.
# REQUIRE_EMAIL_VERIFICATION=false
# Optional. Web origin used in emailed links. Default: the first CORS_ORIGIN.
# APP_URL=http://localhost:5173
# Optional. Outgoing email. Without SMTP_HOST, emails are printed to this API's log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Midivory <no-reply@example.com>
# Optional. Google sign-in: comma-separated OAuth client IDs (Web, Android). Unset = off.
# GOOGLE_CLIENT_IDS=
# Optional error monitoring (Sentry, EU). Unset = off. See docs/operations.md.
# SENTRY_DSN=
# SENTRY_TUNNEL_DSNS=
